{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "bash": {
      "node *": "allow",
      "git status*": "allow",
      "git add*": "allow",
      "git commit*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git mv*": "allow",
      "hugo*": "allow",
      "cat *": "allow",
      "ls *": "allow",
      "cp *": "allow",
      "mv *": "allow",
      "mkdir *": "allow",
      "find *": "allow",
      "grep *": "allow",
      "curl *": "allow",
      "*": "ask"
    }
  }
}
